# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for authentication tokens (required, use a strong random string)
JWT_SECRET=your-secret-key-change-this-in-production

# Optional: hourly rate for projected labor cost (default 20)
LABOR_BASE_RATE=20

# Optional: hours before shift start when edits are blocked for managers (default 48). Admins can bypass per-request in the API.
SHIFT_EDIT_CUTOFF_HOURS=48
